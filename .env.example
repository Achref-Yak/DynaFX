# Cognitive Reasoning Graph Engine — Environment Variables
#
# Copy this to .env and fill in your values.
# The engine will load .env automatically at startup.

# Groq API key — get yours at https://console.groq.com/keys
# Required by pydantic_ai's Groq provider for LLM inference.
GROQ_API_KEY="gsk_your_api_key_here"
